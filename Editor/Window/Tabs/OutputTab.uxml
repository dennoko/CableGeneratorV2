<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <!-- 出力タブ — 軽くして書き出す（設計書 §5.4）。OutputTab.cs が接続する。出力先はウィンドウの出力ドック -->

    <!-- 軽量化（LOD。トグル付きセクション） -->
    <ui:VisualElement class="dennoko-card">
        <ui:VisualElement class="dennoko-card-header dennoko-toggle-header">
            <ui:Toggle name="lod-toggle" binding-path="enableLod" text="#output.lod" tooltip="#output.lod.tip" class="dennoko-section-title" />
        </ui:VisualElement>
        <ui:VisualElement name="lod-content" class="dennoko-toggle-section__content">
            <uie:PropertyField binding-path="lod1ScreenHeight" label="#output.lod1" tooltip="#output.lod1.tip" />
            <uie:PropertyField binding-path="lod2ScreenHeight" label="#output.lod2" tooltip="#output.lod2.tip" />
            <uie:PropertyField binding-path="lodCullScreenHeight" label="#output.cull" tooltip="#output.cull.tip" />
            <ui:VisualElement class="dennoko-info-row">
                <ui:Label name="lod-info" text="" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="legacy-bones" class="dennoko-inline-warning">
            <ui:Label text="#output.legacyBones" class="dennoko-inline-warning__text" />
            <ui:Button name="legacy-bones-remove" text="#output.legacyBones.remove" class="dennoko-inline-warning__action" />
        </ui:VisualElement>
    </ui:VisualElement>

    <!-- 形式 -->
    <ui:VisualElement class="dennoko-card">
        <ui:Label text="#output.format" class="dennoko-section-title dennoko-card-header" />
        <ui:VisualElement name="format" class="dennoko-segmented dennoko-choice-group">
            <ui:Button text="#output.format.mesh" tooltip="#output.format.mesh.tip" />
            <ui:Button text="#output.format.fbx" tooltip="#output.format.fbx.tip" />
        </ui:VisualElement>
        <ui:VisualElement name="fbx-options">
            <ui:VisualElement class="dennoko-field-row">
                <ui:Label text="#output.fbxLod" class="dennoko-field-row__label" />
                <ui:VisualElement name="fbx-lod" class="dennoko-segmented dennoko-choice-group">
                    <ui:Button text="LOD0" tooltip="#output.fbxLod0.tip" />
                    <ui:Button text="LOD1" tooltip="#output.fbxLod1.tip" />
                    <ui:Button text="LOD2" tooltip="#output.fbxLod2.tip" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Toggle name="fbx-bones" text="#output.bones" tooltip="#output.bones.tip" />
            <uie:PropertyField name="bone-count" binding-path="boneCount" label="#output.boneCount" />
            <ui:Label name="bones-hint" text="#output.bones.hint" class="dennoko-hint" />
            <ui:Toggle name="fbx-place" text="#output.place" tooltip="#output.place.tip" />
        </ui:VisualElement>
        <ui:Label name="mesh-hint" text="#output.mesh.hint" class="dennoko-hint" />
    </ui:VisualElement>
</ui:UXML>
